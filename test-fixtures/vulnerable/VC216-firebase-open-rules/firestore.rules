rules_version = '2';

// Generated by an AI app builder: "make the database work".
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Looks scoped, but the root wildcard below grants everything anyway:
    // Firestore rules are OR-ed.
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /posts/{postId} {
      allow read: if true;
      allow update, delete: if true;
    }
  }
}
