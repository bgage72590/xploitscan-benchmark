# Env file for a Vite web app and its Expo companion app. Each secret
# below carries a prefix that the framework builds into code shipped to every
# visitor or app user (Vite: VITE_, Expo: EXPO_PUBLIC_, Create React App:
# REACT_APP_, SvelteKit/Astro: PUBLIC_, Nuxt: NUXT_PUBLIC_). VC011 must fire on
# each of the five secret lines; the Supabase URL and anon key are public.
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_ANON_KEY=not-a-real-anon-key-0000

VITE_OPENAI_API_KEY=replace-with-server-side-value-0000
EXPO_PUBLIC_STRIPE_SECRET_KEY=replace-with-server-side-value-0001
REACT_APP_ADMIN_TOKEN=replace-with-server-side-value-0002
PUBLIC_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-value-0003
NUXT_PUBLIC_JWT_SECRET=replace-with-server-side-value-0004
