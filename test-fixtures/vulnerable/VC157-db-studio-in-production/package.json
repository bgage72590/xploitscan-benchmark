{
  "name": "acme-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && concurrently \"next start -p $PORT\" \"prisma studio --port 5555 --browser none\"",
    "lint": "next lint",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "concurrently": "^8.2.2",
    "next": "16.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "typescript": "^5.5.4"
  }
}
