# Staging environment file loaded by `dotenv -e staging.env -- next build`.
# Server-side credentials were given a NEXT_PUBLIC_ prefix so the marketing
# page could read them directly — this inlines them into the browser bundle.
# Triggers VC011 (Secret in NEXT_PUBLIC_ Environment Variable).

NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiEXAMPLE.eyJyb2xlIjoiYW5vbkVYQU1QTEUifQ.0000EXAMPLE0000

# Wrong: these are server-only credentials and must never ship to the client.
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiEXAMPLE.eyJyb2xlIjoic2VydmljZV9yb2xlRVhBTVBMRSJ9.0000EXAMPLE0000
NEXT_PUBLIC_SENDGRID_API_TOKEN=SG.EXAMPLE0000000000000000.EXAMPLE0000000000000000000000000000000000000

DATABASE_URL=postgres://app:EXAMPLE0000@db.internal.example.com:5432/staging
