# Whole JSON documents stored in one dotenv variable each. The entropy scanner
# read a dotenv value as one candidate and dropped any over 256 characters, so
# the secrets inside these documents got no finding from any rule.
GOOGLE_OAUTH_CLIENT='{"web":{"client_id":"000000000000-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com","project_id":"my-app-123","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","client_secret":"aRNNVDBnVgX8yewUepmggjsTXQdvPhEdUjF","redirect_uris":["https://my-app.example.com/api/auth/callback"]}}'
STORAGE_CONFIG='{"region":"us-east-1","bucket":"uploads","secret_access_key":"zbQhjZDqUiGponTZJz5qTo7no3hFu9mCyZbdwCsP"}'
