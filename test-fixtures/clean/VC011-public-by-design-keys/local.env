# Keys that are public by design and must ship to the browser for their SDKs
# to work: Supabase publishable/anon, Firebase web config, Maps/Mapbox browser
# tokens, captcha site keys, Pusher (Laravel's default .env exposes it),
# PostHog project keys. Plus names that only LOOK key-like: Keycloak URLs,
# crypto token lists, a boolean feature flag. VC011 must fire on none of them.
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_not_a_real_value_0000
VITE_SUPABASE_ANON_KEY=not-a-real-anon-key-0000
VITE_FIREBASE_API_KEY=not-a-real-firebase-web-key-0000
VITE_GOOGLE_MAPS_API_KEY=not-a-real-maps-key-0000
VITE_MAPBOX_TOKEN=not-a-real-mapbox-public-token-0000
VITE_RECAPTCHA_SITE_KEY=not-a-real-site-key-0000
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
EXPO_PUBLIC_POSTHOG_KEY=not-a-real-posthog-key-0000
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_KEYCLOAK_URL=https://auth.example.com
REACT_APP_CHAIN_FEE_TOKENS=untrn,uatom
# These were reported by VC011 before this change (NEXT_PUBLIC_ only):
NEXT_PUBLIC_FIREBASE_API_KEY=not-a-real-firebase-web-key-0001
NEXT_PUBLIC_POSTHOG_KEY=not-a-real-posthog-key-0001
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NEXT_PUBLIC_CLIENT_PASSWORD_PROTECTION=true
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
