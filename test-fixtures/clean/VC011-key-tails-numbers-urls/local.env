# Browser-exposed names that hold no credential. VC011 and ENTROPY must stay
# silent: key words followed by a non-secret tail, numbers in settings that
# mention a password, plain endpoint URLs under key-like names, identifiers,
# captcha site keys, and crypto token metadata.
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=8
NEXT_PUBLIC_REQUIRE_PASSWORD=1
NEXT_PUBLIC_CLIENT_PASSWORD_PROTECTION=true
NEXT_PUBLIC_TOKEN_DECIMALS=18
NEXT_PUBLIC_TOKEN_TICKER=USDC
NEXT_PUBLIC_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_CHAIN_FEE_TOKENS=untrn,uatom
NEXT_PUBLIC_API_KEY_URL=https://keys.example.com/v2/getting-started
NEXT_PUBLIC_API_TOKEN_ENDPOINT=https://auth.example.com/oauth/token
VITE_ACCESS_TOKEN_TTL=3600
VITE_HOTKEYS_ENABLED=true
NEXT_PUBLIC_AUTH0_CLIENT_ID=EcszTYtSStXCMYnjkCkMSk9gCHW5Wj92
NEXT_PUBLIC_RECAPTCHA_CLIENT='RWM7kEkRz3GuMCm7Xa3XyMKD6DUrBLeGnvBvj4EH'
NEXT_PUBLIC_SHOW_PIN=1234
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_SERVICE_ACCOUNT_EMAIL=ci@my-app-123.iam.gserviceaccount.com
NEXT_PUBLIC_MASTER_BRANCH=main
